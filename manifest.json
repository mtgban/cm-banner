{
  "manifest_version": 3,
  "name": "cm-banner",
  "version": "0.1.0",
  "description": "Export a Cardmarket offers page as a CSV for upload to BAN.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cm-banner@mtgban.com",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cardmarket.com/*/Magic/Users/*/Offers/*",
        "https://www.cardmarket.com/*/Pokemon/Users/*/Offers/*",
        "https://www.cardmarket.com/*/YuGiOh/Users/*/Offers/*",
        "https://www.cardmarket.com/*/Lorcana/Users/*/Offers/*",
        "https://www.cardmarket.com/*/OnePiece/Users/*/Offers/*",
        "https://www.cardmarket.com/*/FleshAndBlood/Users/*/Offers/*",
        "https://www.cardmarket.com/*/Riftbound/Users/*/Offers/*"
      ],
      "js": [
        "src/rates.js",
        "src/parse.js",
        "src/csv.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.mtgban.com/upload*"
      ],
      "js": [
        "src/fill.js"
      ],
      "css": [
        "src/fill.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
