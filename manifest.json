{
  "manifest_version": 3,
  "name": "cm-banner",
  "version": "0.1.0",
  "description": "Export a Cardmarket offers page as a CSV for upload to BAN.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cm-banner@mtgban.com",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cardmarket.com/*/*/Users/*/Offers/*"
      ],
      "js": [
        "src/rates.js",
        "src/parse.js",
        "src/pages.js",
        "src/csv.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
